package list

import (
	"fmt"
	db "main.go/db/sqlc"
	"main.go/views/forms"
	"main.go/views/layout"
)

templ Pacientes(items []db.Paciente) {
	@layout.Page("Pacientes", pacientesPage(items))
}

templ pacientesPage(items []db.Paciente) {
	@forms.PacienteForm()
	@PacienteList(items)
}

templ PacienteList(items []db.Paciente) {
	<div class="panel-card" id="pacientes-list">
		<div class="panel-heading">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<h2 style="margin: 0;">Pacientes</h2>
				<span class="badge">{ fmt.Sprint(len(items)) }</span>
			</div>
		</div>
		if len(items) == 0 {
			<p style="color: var(--muted); padding: 1.5rem 0; margin: 0;">Todavía no hay pacientes registrados.</p>
		} else {
			<div style="overflow-x: auto;">
				<table>
					<thead>
						<tr>
							<th style="width: 80px;">ID</th>
							<th>Nombre y Apellido</th>
							<th style="width: 120px; text-align: right;">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr>
								<td class="record-id">#{ fmt.Sprint(item.IDPaciente) }</td>
								<td><strong>{ item.Nombre }</strong></td>
								<td style="text-align: right;">
									<button
										class="delete-button"
										type="button"
										hx-delete={ "/pacientes/" + fmt.Sprint(item.IDPaciente) }
										hx-target="closest tr"
										hx-swap="outerHTML"
										hx-confirm="¿Estás seguro de eliminar este paciente?"
									>Eliminar</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

