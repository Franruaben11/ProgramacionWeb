templ Avisos(items []db.Aviso) { @layout.Page("Avisos", avisoList(items)) }
templ avisoList(items []db.Aviso) {
<a class="button" href="/web/avisos/nuevo">Nuevo aviso</a>
<table><tr><th>Nombre</th><th>Descripción</th><th>Inicio</th><th>Acciones</th></tr>
for _, item := range items {
<tr><td>{ item.Nombre }</td><td>{ item.Descripcion }</td><td>{ item.FechaHoraInicio.Format("02/01/2006 15:04") }</td><td><form method="post" action={ "/web/avisos/" + fmt.Sprint(item.IDAviso) + "/delete" }><button type="submit">Eliminar</button></form></td></tr>
}
</table>
}
