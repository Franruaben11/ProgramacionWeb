package list

import (
 "fmt"
 db "main.go/db/sqlc"
 "main.go/views/layout"
)

templ Pacientes(items []db.Paciente) { @layout.Page("Pacientes", pacienteList(items)) }
templ pacienteList(items []db.Paciente) {
<a class="button" href="/web/pacientes/nuevo">Nuevo paciente</a>
<table><tr><th>ID</th><th>Nombre</th><th>Acciones</th></tr>
for _, item := range items {
<tr><td>{ fmt.Sprint(item.IDPaciente) }</td><td>{ item.Nombre }</td><td><form method="post" action={ "/web/pacientes/" + fmt.Sprint(item.IDPaciente) + "/delete" }><button type="submit">Eliminar</button></form></td></tr>
}
</table>
}

templ Enfermeros(items []db.Enfermero) { @layout.Page("Enfermeros", enfermeroList(items)) }
templ enfermeroList(items []db.Enfermero) {
<a class="button" href="/web/enfermeros/nuevo">Nuevo enfermero</a>
<table><tr><th>ID</th><th>Nombre</th><th>Acciones</th></tr>
