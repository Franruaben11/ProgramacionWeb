templ Avisos(items []db.Aviso, pacientes []db.Paciente, enfermeros []db.Enfermero) {
	@layout.Page("Avisos", avisosPage(items, pacientes, enfermeros))
}

templ avisosPage(items []db.Aviso, pacientes []db.Paciente, enfermeros []db.Enfermero) {
	@forms.AvisoForm(pacientes, enfermeros)
	@AvisoList(items)
}

templ AvisoList(items []db.Aviso) {
	<div class="panel-card" id="avisos-list">
		<div class="panel-heading">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<h2 style="margin: 0;">Avisos y Actividades</h2>
				<span class="badge">{ fmt.Sprint(len(items)) }</span>
			</div>
		</div>
		if len(items) == 0 {
			<p style="color: var(--muted); padding: 1.5rem 0; margin: 0;">Todavía no hay avisos registrados.</p>
		} else {
			<div style="overflow-x: auto;">
				<table>
					<thead>
						<tr>
							<th style="width: 80px;">ID</th>
							<th>Título</th>
							<th>Descripción</th>
							<th>Fecha y Hora</th>
							<th style="width: 120px; text-align: right;">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr>
								<td class="record-id">#{ fmt.Sprint(item.IDAviso) }</td>
								<td><strong>{ item.Nombre }</strong></td>
								<td style="color: var(--muted);">{ item.Descripcion }</td>
								<td>{ item.FechaHoraInicio.Format("02/01/2006 15:04") }</td>
								<td style="text-align: right;">
									<button
										class="delete-button"
										type="button"
										hx-delete={ "/avisos/" + fmt.Sprint(item.IDAviso) }
										hx-target="closest tr"
										hx-swap="outerHTML"
										hx-confirm="¿Estás seguro de eliminar este aviso?"
									>Eliminar</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
