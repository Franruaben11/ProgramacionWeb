}
</table>
}

templ Familiares(items []db.Familiare) { @layout.Page("Familiares", familiarList(items)) }
templ familiarList(items []db.Familiare) {
<a class="button" href="/web/familiares/nuevo">Nuevo familiar</a>
<table><tr><th>ID</th><th>Nombre</th><th>Acciones</th></tr>
for _, item := range items {
<tr><td>{ fmt.Sprint(item.IDFamiliar) }</td><td>{ item.Nombre }</td><td><form method="post" action={ "/web/familiares/" + fmt.Sprint(item.IDFamiliar) + "/delete" }><button type="submit">Eliminar</button></form></td></tr>
}
