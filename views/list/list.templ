package list

import (
	"fmt"
	db "main.go/db/sqlc"
	"main.go/views/layout"
)

templ Pacientes(items []db.Paciente) {
	@layout.Page("Pacientes", pacienteList(items))
}

templ pacienteList(items []db.Paciente) {
	<div class="panel-card">
		<div class="panel-heading">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<h2 style="margin: 0;">Pacientes</h2>
				<span class="badge">{ fmt.Sprint(len(items)) }</span>
			</div>
			<a class="button button-primary" href="/pacientes/nuevo">+ Nuevo paciente</a>
		</div>
		if len(items) == 0 {
			<p style="color: var(--muted); padding: 1.5rem 0; margin: 0;">Todavía no hay pacientes registrados.</p>
		} else {
			<div style="overflow-x: auto;">
				<table>
					<thead>
						<tr>
							<th style="width: 80px;">ID</th>
							<th>Nombre y Apellido</th>
							<th style="width: 120px; text-align: right;">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr>
								<td class="record-id">#{ fmt.Sprint(item.IDPaciente) }</td>
								<td><strong>{ item.Nombre }</strong></td>
								<td style="text-align: right;">
									<form method="post" action={ templ.SafeURL("/pacientes/" + fmt.Sprint(item.IDPaciente) + "/delete") } style="display: inline;">
										<button class="delete-button" type="submit">Eliminar</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

