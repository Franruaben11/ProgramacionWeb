package layout

templ Page(title string, content templ.Component) {
<!doctype html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ title } · La Casa del Ángel</title><link rel="stylesheet" href="/styles.css"/></head>
<body><header><a href="/web">La Casa del Ángel</a><nav><a href="/web/pacientes">Pacientes</a><a href="/web/enfermeros">Enfermeros</a><a href="/web/familiares">Familiares</a><a href="/web/avisos">Avisos</a></nav></header><main><h1>{ title }</h1>@content</main></body>
</html>
}
