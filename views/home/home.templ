package home

import "main.go/views/layout"

templ Home() {
	@layout.Page("Panel de administración", homeContent())
}

templ homeContent() {
	<div class="hero-content" style="padding: 1rem 0 3.5rem 0;">
		<p class="eyebrow">Panel de gestión</p>
		<h1>Información clara para el cuidado diario.</h1>
		<p class="hero-text">
			Accedé rápidamente a los registros de pacientes, personal de enfermería, familiares y avisos de la residencia.
		</p>
	</div>
	<div class="section-heading">
		<div>
			<p class="eyebrow">Administración</p>
			<h2>Módulos de la residencia</h2>
		</div>
	</div>
	<div class="cards">
		<a class="card" href="/pacientes">
			<span class="card-number">01</span>
			<h3>Pacientes</h3>
			<p>Registro y seguimiento de los residentes del geriátrico.</p>
			<span class="card-link">Ver pacientes <span>&rarr;</span></span>
		</a>
		<a class="card" href="/enfermeros">
			<span class="card-number">02</span>
			<h3>Enfermeros</h3>
			<p>Personal de enfermería responsable del cuidado y actividades.</p>
			<span class="card-link">Ver enfermeros <span>&rarr;</span></span>
		</a>
		<a class="card" href="/familiares">
			<span class="card-number">03</span>
			<h3>Familiares</h3>
			<p>Personas de contacto vinculadas al seguimiento del paciente.</p>
			<span class="card-link">Ver familiares <span>&rarr;</span></span>
		</a>
		<a class="card" href="/avisos">
			<span class="card-number">04</span>
			<h3>Avisos</h3>
			<p>Registro de actividades, medicación y comunicaciones diarias.</p>
			<span class="card-link">Ver avisos <span>&rarr;</span></span>
		</a>
	</div>
}
