package forms

import (
	"fmt"
	db "main.go/db/sqlc"
)

templ PacienteForm() {
	<div class="panel-card" style="max-width: 560px; margin: 0 auto 2rem auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo paciente</h2>
		</div>
		<form class="stack-form" method="post" action="/pacientes" hx-post="/pacientes" hx-target="#pacientes-list" hx-swap="outerHTML">
			<div class="notice-field">
				<label for="paciente-nombre">Nombre y apellido</label>
				<input id="paciente-nombre" name="nombre" placeholder="Ej: Juan Pérez" required/>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar paciente</button>
			</div>
		</form>
	</div>
}

templ EnfermeroForm() {
	<div class="panel-card" style="max-width: 560px; margin: 0 auto 2rem auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo enfermero</h2>
		</div>
		<form class="stack-form" method="post" action="/enfermeros" hx-post="/enfermeros" hx-target="#enfermeros-list" hx-swap="outerHTML">
			<div class="notice-field">
				<label for="enfermero-nombre">Nombre y apellido</label>
				<input id="enfermero-nombre" name="nombre" placeholder="Ej: Carlos Gómez" required/>
			</div>
			<div class="notice-field">
				<label for="enfermero-clave">Contraseña</label>
				<input id="enfermero-clave" type="password" name="contrasena" required/>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar enfermero</button>
			</div>
		</form>
	</div>
}

templ FamiliarForm() {
	<div class="panel-card" style="max-width: 560px; margin: 0 auto 2rem auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo familiar</h2>
		</div>
		<form class="stack-form" method="post" action="/familiares" hx-post="/familiares" hx-target="#familiares-list" hx-swap="outerHTML">
			<div class="notice-field">
				<label for="familiar-nombre">Nombre y apellido</label>
				<input id="familiar-nombre" name="nombre" placeholder="Ej: María Gómez" required/>
			</div>
			<div class="notice-field">
				<label for="familiar-clave">Contraseña</label>
				<input id="familiar-clave" type="password" name="contrasena" required/>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar familiar</button>
			</div>
		</form>
	</div>
}

templ AvisoForm(pacientes []db.Paciente, enfermeros []db.Enfermero) {
	<div class="panel-card" style="max-width: 680px; margin: 0 auto 2rem auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo aviso</h2>
		</div>
		<form class="notice-form" method="post" action="/avisos" hx-post="/avisos" hx-target="#avisos-list" hx-swap="outerHTML">
			<div class="notice-row">
				<div class="notice-field">
					<label for="web-aviso-nombre">Título del aviso</label>
					<input id="web-aviso-nombre" name="nombre" placeholder="Ej: Desayuno y medicación" required/>
				</div>
			</div>
			<div class="notice-row">
				<div class="notice-field">
					<label for="web-aviso-descripcion">Descripción detallada</label>
					<textarea id="web-aviso-descripcion" name="descripcion" placeholder="Detalle de la actividad o medicación administrada..." required></textarea>
				</div>
			</div>
			<div class="notice-row">
				<div class="notice-field">
					<label for="web-aviso-inicio">Fecha y hora de inicio</label>
					<input id="web-aviso-inicio" type="datetime-local" name="fecha_hora_inicio" required/>
				</div>
			</div>
			<div class="notice-row notice-row-related">
				<div class="notice-field">
					<label for="web-aviso-paciente">Paciente asociado</label>
					<select id="web-aviso-paciente" name="id_paciente" required>
						<option value="">Seleccionar paciente</option>
						for _, paciente := range pacientes {
							<option value={ fmt.Sprint(paciente.IDPaciente) }>{ paciente.Nombre }</option>
						}
					</select>
				</div>
				<div class="notice-field">
					<label for="web-aviso-enfermero">Enfermero responsable</label>
					<select id="web-aviso-enfermero" name="id_enfermero" required>
						<option value="">Seleccionar enfermero</option>
						for _, enfermero := range enfermeros {
							<option value={ fmt.Sprint(enfermero.IDEnfermero) }>{ enfermero.Nombre }</option>
						}
					</select>
				</div>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar aviso</button>
			</div>
		</form>
	</div>
}
