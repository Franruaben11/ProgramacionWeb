package forms

import (
	"fmt"
	"main.go/views/layout"
	db "main.go/db/sqlc"
)

templ Paciente() { @layout.Page("Nuevo paciente", pacienteForm()) }
templ pacienteForm() { <form method="post" action="/pacientes"><label>Nombre<input name="nombre" required/></label><button type="submit">Guardar</button></form> }

templ Enfermero() { @layout.Page("Nuevo enfermero", enfermeroForm()) }
templ enfermeroForm() { <form method="post" action="/enfermeros"><label>Nombre<input name="nombre" required/></label><label>Contraseña<input type="password" name="contrasena" required/></label><button type="submit">Guardar</button></form> }

templ Familiar() { @layout.Page("Nuevo familiar", familiarForm()) }
templ familiarForm() { <form method="post" action="/familiares"><label>Nombre<input name="nombre" required/></label><label>Contraseña<input type="password" name="contrasena" required/></label><button type="submit">Guardar</button></form> }

templ Aviso(pacientes []db.Paciente, enfermeros []db.Enfermero) {
	@layout.Page("Nuevo aviso", avisoForm(pacientes, enfermeros))
}
templ avisoForm(pacientes []db.Paciente, enfermeros []db.Enfermero) {
	<form class="notice-form" method="post" action="/avisos">
		<div class="notice-row"><div class="notice-field"><label for="web-aviso-nombre">Nombre</label><input id="web-aviso-nombre" name="nombre" required/></div></div>
		<div class="notice-row"><div class="notice-field"><label for="web-aviso-descripcion">Descripción</label><textarea id="web-aviso-descripcion" name="descripcion" required></textarea></div></div>
		<div class="notice-row"><div class="notice-field"><label for="web-aviso-inicio">Inicio</label><input id="web-aviso-inicio" type="datetime-local" name="fecha_hora_inicio" required/></div></div>
		<div class="notice-row notice-row-related">
			<div class="notice-field"><label for="web-aviso-paciente">Paciente</label>
				<select id="web-aviso-paciente" name="id_paciente" required>
					<option value="">Seleccionar paciente</option>
					for _, paciente := range pacientes {
						<option value={ fmt.Sprint(paciente.IDPaciente) }>{ paciente.Nombre }</option>
					}
				</select>
			</div>
			<div class="notice-field"><label for="web-aviso-enfermero">Enfermero</label>
				<select id="web-aviso-enfermero" name="id_enfermero" required>
					<option value="">Seleccionar enfermero</option>
					for _, enfermero := range enfermeros {
						<option value={ fmt.Sprint(enfermero.IDEnfermero) }>{ enfermero.Nombre }</option>
					}
				</select>
			</div>
		</div>
		<button type="submit">Guardar</button>
	</form>
}
