package forms

import (
	"fmt"
	db "main.go/db/sqlc"
	"main.go/views/layout"
)

templ Paciente() {
	@layout.Page("Nuevo paciente", pacienteForm())
}

templ pacienteForm() {
	<div class="panel-card" style="max-width: 560px; margin: 0 auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo paciente</h2>
		</div>
		<form class="stack-form" method="post" action="/pacientes">
			<div class="notice-field">
				<label for="paciente-nombre">Nombre y apellido</label>
				<input id="paciente-nombre" name="nombre" placeholder="Ej: Juan Pérez" required/>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar paciente</button>
				<a class="button" href="/pacientes" style="border: 1px solid var(--line);">Cancelar</a>
			</div>
		</form>
	</div>
}

templ Enfermero() {
	@layout.Page("Nuevo enfermero", enfermeroForm())
}

templ enfermeroForm() {
	<div class="panel-card" style="max-width: 560px; margin: 0 auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo enfermero</h2>
		</div>
		<form class="stack-form" method="post" action="/enfermeros">
			<div class="notice-field">
				<label for="enfermero-nombre">Nombre y apellido</label>
				<input id="enfermero-nombre" name="nombre" placeholder="Ej: Carlos Gómez" required/>
			</div>
			<div class="notice-field">
				<label for="enfermero-clave">Contraseña</label>
				<input id="enfermero-clave" type="password" name="contrasena" required/>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar enfermero</button>
				<a class="button" href="/enfermeros" style="border: 1px solid var(--line);">Cancelar</a>
			</div>
		</form>
	</div>
}

templ Familiar() {
	@layout.Page("Nuevo familiar", familiarForm())
}

templ familiarForm() {
	<div class="panel-card" style="max-width: 560px; margin: 0 auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo familiar</h2>
		</div>
		<form class="stack-form" method="post" action="/familiares">
			<div class="notice-field">
				<label for="familiar-nombre">Nombre y apellido</label>
				<input id="familiar-nombre" name="nombre" placeholder="Ej: María Gómez" required/>
			</div>
			<div class="notice-field">
				<label for="familiar-clave">Contraseña</label>
				<input id="familiar-clave" type="password" name="contrasena" required/>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar familiar</button>
				<a class="button" href="/familiares" style="border: 1px solid var(--line);">Cancelar</a>
