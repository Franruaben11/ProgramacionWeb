}

templ Aviso(pacientes []db.Paciente, enfermeros []db.Enfermero) {
	@layout.Page("Nuevo aviso", avisoForm(pacientes, enfermeros))
}

templ avisoForm(pacientes []db.Paciente, enfermeros []db.Enfermero) {
	<div class="panel-card" style="max-width: 680px; margin: 0 auto;">
		<div class="panel-heading">
			<h2>Registrar nuevo aviso</h2>
		</div>
		<form class="notice-form" method="post" action="/avisos">
			<div class="notice-row">
				<div class="notice-field">
					<label for="web-aviso-nombre">Título del aviso</label>
					<input id="web-aviso-nombre" name="nombre" placeholder="Ej: Desayuno y medicación" required/>
				</div>
			</div>
			<div class="notice-row">
				<div class="notice-field">
					<label for="web-aviso-descripcion">Descripción detallada</label>
					<textarea id="web-aviso-descripcion" name="descripcion" placeholder="Detalle de la actividad o medicación administrada..." required></textarea>
				</div>
			</div>
			<div class="notice-row">
				<div class="notice-field">
					<label for="web-aviso-inicio">Fecha y hora de inicio</label>
					<input id="web-aviso-inicio" type="datetime-local" name="fecha_hora_inicio" required/>
				</div>
			</div>
			<div class="notice-row notice-row-related">
				<div class="notice-field">
					<label for="web-aviso-paciente">Paciente asociado</label>
					<select id="web-aviso-paciente" name="id_paciente" required>
						<option value="">Seleccionar paciente</option>
						for _, paciente := range pacientes {
							<option value={ fmt.Sprint(paciente.IDPaciente) }>{ paciente.Nombre }</option>
						}
					</select>
				</div>
				<div class="notice-field">
					<label for="web-aviso-enfermero">Enfermero responsable</label>
					<select id="web-aviso-enfermero" name="id_enfermero" required>
						<option value="">Seleccionar enfermero</option>
						for _, enfermero := range enfermeros {
							<option value={ fmt.Sprint(enfermero.IDEnfermero) }>{ enfermero.Nombre }</option>
						}
					</select>
				</div>
			</div>
			<div style="display: flex; gap: 1rem; margin-top: 1rem;">
				<button class="button button-primary" type="submit">Guardar aviso</button>
				<a class="button" href="/avisos" style="border: 1px solid var(--line);">Cancelar</a>
			</div>
		</form>
	</div>
}
